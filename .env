# 公开模板：地址、API key、私钥、代理、账户编号已清空。
# 只保留端口、阈值、公开接口地址等非密钥默认值。请在本机填写后再启动，不要把真密钥提交回去。
# ── 服务 ────────────────────────────────────────────────
HOST=127.0.0.1
# 面板端口；和别的程序冲突时改这里
PORT=8004

# ── Arcus ───────────────────────────────────────────────
ARCUS_API_URL=https://api.arcus.xyz
# 主钱包公开地址（0x + 40 位十六进制），不是私钥
ARCUS_ADDRESS=
# 子账户 0~9
ARCUS_ACCOUNT_INDEX=0
# Ed25519 API 私钥：64 位 seed hex 或 PKCS#8 PEM/DER；也可以填文件路径到下一行
ARCUS_API_PRIVATE_KEY=
ARCUS_API_PRIVATE_KEY_FILE=
# Ed25519 API 公钥（64 位十六进制）。可以留空 —— 程序会由私钥推导；
# 填了就必须和私钥是一对，否则拒绝下单
ARCUS_API_KEY=

# ── RHC Lighter (Robinhood Chain) ──────────────────────
LIGHTER_BASE_URL=https://api.rh.lighter.xyz
LIGHTER_ACCOUNT_INDEX=
# ⚠ 如果还有别的程序在用同一个 Lighter 账户，这里必须用【另一个】API key 编号，
#   两个程序共用一个 key 会互相顶掉 nonce，下单大面积失败。
#   另外不要让两个程序在同一个账户上交易同一个币种 —— 会把对方的仓位当成孤腿平掉。
LIGHTER_API_KEY_INDEX=4
LIGHTER_API_PRIVATE_KEY=

# ── 独立 IP / 代理（留空 = 直连）────────────────────────
# 支持 http:// https:// socks5://  例：socks5://user:pass@1.2.3.4:1080
# 也支持 host:port:user:pass（按 socks5 解析）和 host:port（按 http 解析）
ARCUS_PROXY=
LIGHTER_PROXY=
# 两个所都没单独配时的兜底代理
GLOBAL_PROXY=

# ── 费率快照 ────────────────────────────────────────────
FUNDING_REFRESH_SECONDS=30
FUNDING_STALE_MAX_SECONDS=180
FUNDING_TIMEOUT_SECONDS=30

# ── 强平监控 ────────────────────────────────────────────
# 两条腿里更危险的那条距强平价还剩多少百分比算「危险」。
# 到线的处置是双腿同时平掉，绝不单腿止损（单腿平掉 = 另一腿裸奔）。
LIQUIDATION_WARN_DISTANCE_PCT=5

# ── Arcus 挂单模式 ──────────────────────────────────────
# true = Arcus 那条腿挂单（ALO，0 手续费），成交多少就立刻去 Lighter 吃单对冲多少。
#        开仓等不到成交就撤单、下一轮再挂（零成本）；正常轮换平仓等不到的部分改吃单平。
#        风控触发的平仓（离强平太近、两腿不匹配、孤腿）始终立刻吃单，不等。
# false = 两条腿都吃单（Arcus 付 2.25 bps × 2）
ARCUS_MAKER=false
# 挂单最多等多久（秒）。挂单在后台等，不影响其它币种的风控检查
MAKER_WAIT_SECONDS=120

# ── 引擎 ────────────────────────────────────────────────
# 演练模式：true = 只记录意图不下单。先跑通、做完实盘预检再改 false。
DRY_RUN=true
ENGINE_CYCLE_SECONDS=30
# 「走廊」= 离强平还有百分之几。Arcus 是全仓，走廊主要看账户权益 ÷ 仓位大小。
# 开仓门槛：估算走廊低于它就不开
MIN_CORRIDOR_PCT=3
# 平仓线：持仓中任一条腿离强平小于它，两边立刻一起平
# （另有相对触发：剩余距离掉到开仓时的一半也会一起平）
CLOSE_CORRIDOR_PCT=1.5
# 平仓后隔多久才允许重开（秒）—— 防止刚平完就重开连付两次成本
REOPEN_COOLDOWN_SECONDS=60
ORDER_SLIPPAGE_BPS=10

# ── 跨所价差闸门 ────────────────────────────────────────
# 开仓和计划内平仓：Arcus 与 Lighter 绝对价差不超过这么多 bp 才挂 maker。
# 默认 1，接近 0。正好 0 挂不出去，不要改成 0。
# 方向是买更便宜的一边、卖更贵的一边。
# 用于两所都有的全部市场，包括美股永续，不单限 BTC、ETH。
MAX_SPREAD_BPS=1
# 两腿都成交之后至少持有 3 秒，才开始找小价差挂 maker 平仓。
# 不是两腿下单之间的间隔：开仓的买卖可以一起挂。
MIN_HOLD_SEC=3
# 从两腿都成交起满 300 秒（5 分钟）仍未平掉，不再等价差，强制平仓。
MAX_HOLD_SEC=300
